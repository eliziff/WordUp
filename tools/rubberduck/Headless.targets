<Project>
  <!-- Immutable 1.5 resolves to netstandard2.0. VS BuildTools without the
       SDK ImportAfter tasks needs this existing framework-compatible facade. -->
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <Reference Include="netstandard">
      <HintPath>$(MSBuildSDKsPath)\..\Microsoft\Microsoft.NET.Build.Extensions\net461\lib\netstandard.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <PropertyGroup>
    <GenerateSatelliteAssembliesForCore>true</GenerateSatelliteAssembliesForCore>
  </PropertyGroup>
  <!-- The parser uses upstream production code. Only add-in build tooling is
       excluded: deployment tasks and repository-specific style analyzers. -->
  <Target Name="EnsureMetaProjectsBuild" />
  <Target Name="WordUpRemoveRepositoryAnalyzers" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" />
    </ItemGroup>
  </Target>
</Project>
