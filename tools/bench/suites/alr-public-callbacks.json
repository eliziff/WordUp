{
  "schema": 1,
  "name": "Bench: ALR Em Dash and En Dash Ribbon buttons insert through the real Ribbon",
  "require_compile": true,
  "steps": [
    { "name": "Open exact template", "operation": { "op": "open", "file": "$artifact", "as": "template" } },
    { "name": "Compile template", "operation": { "op": "compile", "target": "template", "member": "$project" },
      "assert": [ { "path": "/vba_compiled", "kind": "equals", "expected": true } ] },
    { "name": "Hide VBE", "operation": { "op": "put", "target": "app", "member": "ShowVisualBasicEditor", "value": false } },
    { "name": "Create document", "operation": { "op": "new", "file": "$artifact", "as": "document" } },
    { "name": "Open ALR tab", "operation": { "op": "ui.invoke", "target": "document", "named": { "name": "ALR Tools", "scope": "ribbon", "role": 37, "wait_ms": 2000 } } },
    { "name": "Prepare Em Dash", "operation": { "op": "eval", "value": "ActiveDocument.TrackRevisions = False\nActiveDocument.Content.Text = \"LEFT|RIGHT\"\nActiveDocument.Range(5, 5).Select\nEvaluate = True" } },
    { "name": "Click Em Dash", "operation": { "op": "ui.invoke", "target": "document", "named": { "name": "Em Dash", "scope": "ribbon", "role": 43 } } },
    { "name": "Verify Em Dash", "operation": { "op": "eval", "value": "Evaluate = ActiveDocument.Content.Text" },
      "assert": [ { "path": "/result", "kind": "equals", "expected": "LEFT|—RIGHT\r" } ] },
    { "name": "Undo Em Dash", "operation": { "op": "eval", "value": "Dim undone As Boolean\nundone = ActiveDocument.Undo\nEvaluate = undone And ActiveDocument.Content.Text = \"LEFT|RIGHT\" & vbCr" },
      "assert": [ { "path": "/result", "kind": "equals", "expected": true } ] },
    { "name": "Prepare En Dash", "operation": { "op": "eval", "value": "ActiveDocument.TrackRevisions = False\nActiveDocument.Content.Text = \"LEFT|RIGHT\"\nActiveDocument.Range(5, 5).Select\nEvaluate = True" } },
    { "name": "Click En Dash", "operation": { "op": "ui.invoke", "target": "document", "named": { "name": "En Dash", "scope": "ribbon", "role": 43 } } },
    { "name": "Verify En Dash", "operation": { "op": "eval", "value": "Evaluate = ActiveDocument.Content.Text" },
      "assert": [ { "path": "/result", "kind": "equals", "expected": "LEFT|–RIGHT\r" } ] },
    { "name": "Undo En Dash", "operation": { "op": "eval", "value": "Dim undone As Boolean\nundone = ActiveDocument.Undo\nEvaluate = undone And ActiveDocument.Content.Text = \"LEFT|RIGHT\" & vbCr" },
      "assert": [ { "path": "/result", "kind": "equals", "expected": true } ] },
    { "name": "Close disposable document", "operation": { "op": "unload", "target": "document" } },
    { "name": "Close template", "operation": { "op": "unload", "target": "template", "file": "$artifact" } }
  ]
}
